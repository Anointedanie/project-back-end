# ============================================================================
# ENVIRONMENT VARIABLES FOR DJANGO E-COMMERCE BACKEND
# ============================================================================
#
# This file contains all configuration settings that should NOT be hardcoded
# in your Python files. Copy this file to create your actual .env file:
#
#   cp .env.example .env
#
# Then edit .env with your actual values.
# NEVER commit .env to git (it's in .gitignore)!
#
# ============================================================================

# ============================================================================
# DJANGO SETTINGS
# ============================================================================

# SECRET_KEY: Used for cryptographic signing (sessions, cookies, passwords)
# CRITICAL: Change this in production! Generate a new one at:
# https://djecrety.ir/ or run: python -c 'from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())'
SECRET_KEY=django-insecure-dev-key-change-in-production-abc123xyz789

# DEBUG: Show detailed error pages?
# True = Development (shows full error traces)
# False = Production (hides sensitive information)
# ALWAYS set to False in production!
DEBUG=True

# ALLOWED_HOSTS: Comma-separated list of domains that can serve this Django site
# Development: localhost,127.0.0.1
# Production: yourdomain.com,www.yourdomain.com,api.yourdomain.com
ALLOWED_HOSTS=localhost,127.0.0.1


# ============================================================================
# DATABASE SETTINGS
# ============================================================================

# For Development: SQLite (file-based, easy, no setup required)
# Uncomment these lines for SQLite:
DB_ENGINE=django.db.backends.sqlite3
DB_NAME=db.sqlite3

# For Production: PostgreSQL on AWS RDS (or local PostgreSQL)
# Uncomment and fill in these lines when ready to use PostgreSQL:
# DB_ENGINE=django.db.backends.postgresql
# DB_NAME=ecommerce_db
# DB_USER=postgres
# DB_PASSWORD=your-secure-password-here
# DB_HOST=your-rds-endpoint.amazonaws.com
# DB_PORT=5432

# Migration Path:
# 1. Development: Use SQLite (current setup)
# 2. Testing: Switch to local PostgreSQL
# 3. Production: Use AWS RDS PostgreSQL


# ============================================================================
# JWT (JSON Web Token) SETTINGS
# ============================================================================

# JWT_ACCESS_TOKEN_LIFETIME: How long access tokens are valid (in minutes)
# Access tokens are used for API requests
# Shorter = More secure, but users refresh more often
# Longer = Less secure, but better UX
# Recommended: 15-60 minutes
JWT_ACCESS_TOKEN_LIFETIME=60

# JWT_REFRESH_TOKEN_LIFETIME: How long refresh tokens are valid (in minutes)
# Refresh tokens are used to get new access tokens
# Should be much longer than access token
# Recommended: 1440 minutes (24 hours) to 10080 minutes (7 days)
JWT_REFRESH_TOKEN_LIFETIME=1440

# How JWT works:
# 1. User logs in → gets access token (60 min) + refresh token (24 hours)
# 2. Access token expires after 60 min
# 3. Use refresh token to get new access token
# 4. No need to login again until refresh token expires


# ============================================================================
# CORS (Cross-Origin Resource Sharing) SETTINGS
# ============================================================================

# CORS_ALLOWED_ORIGINS: Comma-separated list of allowed frontend URLs
# These are the domains that can make API requests to your backend
#
# Development (React on localhost:3000):
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Production (add your actual frontend domain):
# CORS_ALLOWED_ORIGINS=https://yourfrontend.com,https://www.yourfrontend.com

# Why CORS?
# Browser security prevents frontend (localhost:3000) from calling
# backend (localhost:8000) unless explicitly allowed
# This setting allows it


# ============================================================================
# FUTURE AWS SETTINGS (for Phase 4+)
# ============================================================================

# AWS S3 Settings (for product images)
# Uncomment when ready to use S3:
# AWS_ACCESS_KEY_ID=your-aws-access-key
# AWS_SECRET_ACCESS_KEY=your-aws-secret-key
# AWS_STORAGE_BUCKET_NAME=your-bucket-name
# AWS_S3_REGION_NAME=us-east-1

# AWS SES Settings (for sending emails)
# Uncomment when ready to use SES:
# AWS_SES_REGION_NAME=us-east-1
# DEFAULT_FROM_EMAIL=noreply@yourdomain.com

# AWS RDS Settings (already covered in DATABASE SETTINGS above)


# ============================================================================
# DJANGO EMAIL SETTINGS (for password reset, notifications)
# ============================================================================

# For Development: Console backend (prints emails to terminal)
# EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

# For Production: SMTP or AWS SES
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=your-email@gmail.com
# EMAIL_HOST_PASSWORD=your-app-password


# ============================================================================
# SECURITY SETTINGS (for Production)
# ============================================================================

# Uncomment these when deploying to production:

# HTTPS/SSL Settings
# SECURE_SSL_REDIRECT=True
# SESSION_COOKIE_SECURE=True
# CSRF_COOKIE_SECURE=True

# HSTS (HTTP Strict Transport Security)
# SECURE_HSTS_SECONDS=31536000
# SECURE_HSTS_INCLUDE_SUBDOMAINS=True
# SECURE_HSTS_PRELOAD=True


# ============================================================================
# ADDITIONAL SETTINGS (Optional)
# ============================================================================

# Time Zone
# TIME_ZONE=UTC

# Language
# LANGUAGE_CODE=en-us

# Static Files (for production with cloud storage)
# STATIC_URL=/static/
# MEDIA_URL=/media/


# ============================================================================
# NOTES FOR DIFFERENT ENVIRONMENTS
# ============================================================================

# Development (.env):
# - DEBUG=True
# - SQLite database
# - Console email backend
# - Local CORS origins

# Staging (.env.staging):
# - DEBUG=False
# - PostgreSQL on test server
# - Real email backend (test account)
# - Staging frontend domain in CORS

# Production (.env.production):
# - DEBUG=False
# - PostgreSQL on AWS RDS
# - AWS SES for emails
# - Production frontend domain in CORS
# - All security settings enabled


# ============================================================================
# QUICK REFERENCE
# ============================================================================

# To use this file:
# 1. Copy: cp .env.example .env
# 2. Edit .env with your actual values
# 3. Django reads .env automatically (using python-decouple)
# 4. Never commit .env to git (it's in .gitignore)

# To change database from SQLite to PostgreSQL:
# 1. Install PostgreSQL locally or set up AWS RDS
# 2. Comment out SQLite settings
# 3. Uncomment PostgreSQL settings
# 4. Fill in DB_NAME, DB_USER, DB_PASSWORD, DB_HOST
# 5. Run: python manage.py migrate

# To generate a new SECRET_KEY:
# python -c 'from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())'
