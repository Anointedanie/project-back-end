---
# Template for Kubernetes Secret
# DO NOT COMMIT secret.yaml with actual values!
# Copy this to secret.yaml and update with your values for local development

apiVersion: v1
kind: Secret
metadata:
  name: backend-secrets
  namespace: ecommerce-backend-ns
type: Opaque
stringData:
  # Django SECRET_KEY - Generate with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
  SECRET_KEY: "your-django-secret-key-here"

# For CI/CD deployments, this secret is created automatically from GitHub Actions secrets
# See .github/workflows/ci-cd.yaml for details
